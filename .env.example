# Copy this file to .env and fill in at least one API key. Never commit .env.
# Groq is the primary provider.
GROQ_API_KEY=

# Optional model override.
GROQ_MODEL=openai/gpt-oss-20b

# Delay between live smoke-test requests to reduce burst rate limiting.
GROQ_REQUEST_DELAY_SECONDS=1.0

# Provider retry policy for HTTP 429 rate-limit responses.
GROQ_MAX_RETRIES=2
GROQ_RETRY_DELAY_SECONDS=1.0
GROQ_TOTAL_TIMEOUT_SECONDS=28.0

# OpenRouter is the secondary provider used when Groq is unavailable.
# The canonical name is OPENROUTER_API_KEY. OPEN_ROUTER_API is also accepted
# for compatibility with an earlier local setup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=1

# SQLite file used by GET /test-dashboard for optimize request latency metrics.
METRICS_DB_PATH=data/request_metrics.sqlite3

# Host port for Docker Compose. Change this if port 8000 is already in use.
HOST_PORT=8000
